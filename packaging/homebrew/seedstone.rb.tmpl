# Rendered by scripts/render-formula.sh from a release's archives and
# checksums; the placeholders are filled, never edited by hand.
class Seedstone < Formula
  desc "In-memory key-value store speaking the Redis protocol, with optional persistence"
  homepage "https://github.com/stefanobaldo/seedstone"
  version "@VERSION@"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "https://github.com/stefanobaldo/seedstone/releases/download/v@VERSION@/seedstone-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "https://github.com/stefanobaldo/seedstone/releases/download/v@VERSION@/seedstone-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/stefanobaldo/seedstone/releases/download/v@VERSION@/seedstone-@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_AARCH64_UNKNOWN_LINUX_GNU@"
    end
    on_intel do
      url "https://github.com/stefanobaldo/seedstone/releases/download/v@VERSION@/seedstone-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_X86_64_UNKNOWN_LINUX_GNU@"
    end
  end

  def install
    bin.install "seedstone"
    doc.install "README.md", "CHANGELOG.md"
  end

  service do
    run [opt_bin/"seedstone", "--data-dir", var/"seedstone"]
    keep_alive true
    working_dir var
    log_path var/"log/seedstone.log"
    error_log_path var/"log/seedstone.log"
  end

  test do
    assert_match "seedstone #{version}", shell_output("#{bin}/seedstone --version")
  end
end
