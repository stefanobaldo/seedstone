/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# The installer is read in a browser as often as it is piped to a shell,
# and a fix to it must reach users in minutes.
/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: max-age=300

# Only the fonts are immutable: a change to the typeface would come with a
# new file name. Everything else under /assets/ keeps a fixed name and
# changes in place — the stylesheet, the script, the charts — so it keeps
# the default headers, which make the browser revalidate.
/assets/inter-400.woff2
  Cache-Control: max-age=31536000, immutable
/assets/inter-700.woff2
  Cache-Control: max-age=31536000, immutable
