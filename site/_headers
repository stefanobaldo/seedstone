# Scripts from this site and Cloudflare's analytics beacon, nothing inline.
# Styles admit 'unsafe-inline' because the bars carry their width as a
# style attribute, so a bar is drawn without a script, and one <noscript>
# style hides the copy button where no script runs. The beacon reports to
# cloudflareinsights.com, or to this origin when the zone proxies it.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# The installer is read in a browser as often as it is piped to a shell,
# and a fix to it must reach users in minutes.
/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: max-age=300

# Only the fonts are immutable: a change to the typeface would come with a
# new file name. Everything else under /assets/ keeps a fixed name and
# changes in place — the stylesheet, the script — so it keeps
# the default headers, which make the browser revalidate.
/assets/inter-400.woff2
  Cache-Control: max-age=31536000, immutable
/assets/inter-700.woff2
  Cache-Control: max-age=31536000, immutable
